# Greymens Club PWA — environment template.
# Copy to `.env.local` or set as project env vars on Vercel. Never commit `.env.local`.

# --- Appwrite (public; safe to expose) ---
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=greymens_db
# Bucket IDs live in code (per-route constants), not env: no bucket variable
# is read from the environment anywhere.

# --- Server only (NEVER prefix with NEXT_PUBLIC_) ---
# Needs scopes: users.read + tables.* (used by API routes + scripts)
APPWRITE_API_KEY=
# Comma-separated bootstrap admin emails (lockout recovery; prefer real user_roles rows)
ADMIN_EMAILS=
# Signs ticket QR payloads. Generate with: openssl rand -hex 32
TICKET_HMAC_SECRET=

# --- Contact / feedback mailer (server only) ---
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
CONTACT_INBOX_EMAIL=hello@greymens.club

# --- Web Push via VAPID (server only; same pair works in every env) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@greymens.club
